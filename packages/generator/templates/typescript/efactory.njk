{% set eFactoryClassifier = findEClassByName(package, "EFactory") %}
{% file factoryClassName(package) + ".ts" %}
import { EClass, EObject{{ ", EFactoryImpl" if not eFactoryClassifier else "" }} } from '@typemf/core';
import { Ids } from './{{ packageClassName(package) }}.js';
{% if eFactoryClassifier %}
import { EFactoryImpl } from './impl/EFactoryImpl.js';
{% endif %}
{% for classifier in concreteEClassesOf(package) %}
import { {{ classifier.getName() }} } from './api/{{ classifier.getName() }}.js';
import { {{ classifier.getName() }}Impl } from './impl/{{ classifier.getName() }}Impl.js';
{% endfor %}

{% if eFactoryClassifier %}
{#- real Ecore's own EFactoryImpl-extends-EFactoryImpl design: this
    package models a classifier literally named "EFactory" (see
    findEClassByName), so the package-level Factory extends ITS generated
    impl instead of the generic @typemf/core base - matching real EMF's
    EcoreFactoryImpl extends EFactoryImpl exactly. This is Ecore-specific
    template logic, not a general pattern: ordinary metamodels never hit
    this branch. Note this deliberately reuses the name "EFactoryImpl" for
    both the generated and the @typemf/core base class - a real, known,
    accepted naming collision for the untested real-named Ecore.ecore
    output (see NOTES.md), not something this template works around. #}
{% endif %}
export class {{ factoryClassName(package) }} extends EFactoryImpl {
{% for classifier in concreteEClassesOf(package) %}
  create{{ classifier.getName() }}(): {{ classifier.getName() }} {
    return new {{ classifier.getName() }}Impl();
  }
{% endfor %}

  create(eClass: EClass): EObject {
    switch (eClass.getClassifierID()) {
{% for classifier in concreteEClassesOf(package) %}
      case Ids.{{ classifier.getName() }}.self:
        return this.create{{ classifier.getName() }}();
{% endfor %}
      default:
        throw new Error(
          `Cannot create an instance of classifier id ${eClass.getClassifierID()}: not a known, concrete classifier of this package.`
        );
    }
  }
}
{% endfile %}
