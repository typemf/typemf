{% set eFactoryClassifier = findEClassByName(package, "EFactory") %}
{% file factoryClassName(package) + ".ts" %}
{{ coreImportLine(["EClass", "EFactory", "EObject"], "root", "types", options, package) }}
import { {% for classifier in concreteEClassesOf(package) %}{{ classifier.getName() }}{% if not loop.last %}, {% endif %}{% endfor %} } from './types/index.js';

export interface {{ factoryClassName(package) }} extends EFactory {
{% for classifier in concreteEClassesOf(package) %}
  create{{ classifier.getName() }}(): {{ classifier.getName() }};
{% endfor %}
  create(eClass: EClass): EObject;
}
{% endfile %}
{% file "impl/" + factoryClassName(package) + "Impl.ts" %}
{{ coreImportLine(["EClass", "EObject"], "impl", "types", options, package) }}
{% if not eFactoryClassifier %}
import { EFactoryImpl } from '{{ coreImportSpecifier("impl", "impl", options) }}';
{% endif %}
import { {{ factoryClassName(package) }} } from '../{{ factoryClassName(package) }}.js';
import { Ids } from '../{{ packageClassName(package) }}.js';
{% if eFactoryClassifier %}
import { EFactoryImpl } from './EFactoryImpl.js';
{% endif %}
import { {% for classifier in concreteEClassesOf(package) %}{{ classifier.getName() }}{% if not loop.last %}, {% endif %}{% endfor %} } from '../types/index.js';
{#- EFactory's own Impl is deliberately excluded from this loop when the
    EFactory-unification special case applies (see above) - it's already
    imported directly there (`from './EFactoryImpl.js'`), and importing it
    a second time here too (`from './index.js'`, which re-exports the same
    file) would be a duplicate binding for the same name. #}
import { {% for classifier in concreteEClassesOf(package) %}{% if not (eFactoryClassifier and classifier.getName() == "EFactory") %}{{ classifier.getName() }}Impl{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} } from './index.js';

{% if eFactoryClassifier %}
{#- real Ecore's own EFactoryImpl-extends-EFactoryImpl design: this
    package models a classifier literally named "EFactory" (see
    findEClassByName), so the package-level FactoryImpl extends ITS
    generated impl (now living at impl/EFactoryImpl.ts, same folder as
    this file, since Gen/Impl merged) instead of the generic @typemf/core
    base - matching real EMF's EcoreFactoryImpl extends EFactoryImpl
    exactly. This is Ecore-specific template logic, not a general pattern:
    ordinary metamodels never hit this branch. Note this deliberately
    reuses the name "EFactoryImpl" for both the generated and the
    @typemf/core base class - a real, known, accepted naming collision for
    the untested real-named Ecore.ecore output (see NOTES.md), not
    something this template works around. #}
{% endif %}
export class {{ factoryClassName(package) }}Impl extends EFactoryImpl implements {{ factoryClassName(package) }} {
{% for classifier in concreteEClassesOf(package) %}
  create{{ classifier.getName() }}(): {{ classifier.getName() }} {
    return new {{ classifier.getName() }}Impl();
  }
{% endfor %}

  create(eClass: EClass): EObject {
    switch (eClass.getClassifierID()) {
{% for classifier in concreteEClassesOf(package) %}
      case Ids.{{ classifier.getName() }}.self:
        return this.create{{ classifier.getName() }}();
{% endfor %}
      default:
        throw new Error(
          `Cannot create an instance of classifier id ${eClass.getClassifierID()}: not a known, concrete classifier of this package.`
        );
    }
  }
}
{% endfile %}
