import type { {{ packageClassName(package) }} } from '../{{ packageClassName(package) }}.js';

/**
 * A reference to the {{ packageClassName(package) }} singleton that every generated class of the package
 * reads instead of importing {{ packageClassName(package) }}Impl, which would be a circular import: the
 * package constructs those classes while it constructs itself. This module only has a type
 * import, so it can be imported from anywhere.
 */
let ref: {{ packageClassName(package) }} | undefined;

/** Constructs the package on first use; registered when {{ packageClassName(package) }}Impl.ts is evaluated. */
let initializer: (() => void) | undefined;
let initializing = false;

export function set{{ packageClassName(package) }}Ref(pkg: {{ packageClassName(package) }}): void {
  ref = pkg;
}

export function register{{ packageClassName(package) }}Initializer(init: () => void): void {
  initializer = init;
}

export function get{{ packageClassName(package) }}Ref(): {{ packageClassName(package) }} {
  // `initializing` turns a reentrant call during construction into the error below.
  if (!ref && initializer && !initializing) {
    initializing = true;
    try {
      initializer();
    } finally {
      initializing = false;
    }
  }
  if (!ref) {
    throw new Error(
      'get{{ packageClassName(package) }}Ref() called before the {{ packageClassName(package) }} singleton finished constructing itself, and no ' +
        'initializer was registered to construct it on demand - this means {{ packageClassName(package) }}Impl.ts\'s own module ' +
        'was never evaluated at all (an unusual bundler/tree-shaking setup). Call {{ packageClassName(package) }}Impl.eINSTANCE ' +
        'or .init() yourself first, or check that this package is marked side-effectful.'
    );
  }
  return ref;
}
