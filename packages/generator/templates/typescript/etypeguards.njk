{% file "util/" + typeGuardsClassName(package) + ".ts" %}
/**
 * Type guards for the classifiers of the package. They check an object's class with
 * `isSuperTypeOf()`, so they also work for abstract classes, interfaces and dynamic objects,
 * unlike `instanceof`.
 */
function hasEClass(obj: unknown): obj is {{ useImport("EObject", "types", {foundational: true}) }} {
  return obj !== null && typeof obj === 'object' && typeof (obj as { eClass?: unknown }).eClass === 'function';
}

{% for classifier in eClassesOf(package) %}
export function is{{ classifier.getName() }}(obj: unknown): obj is {{ useImport(classifier.getName(), "types", {foundational: false}) }} {
  return hasEClass(obj) && {{ useImport("get" + packageClassName(package) + "Ref", "impl", {file: packageClassName(package) + "Ref", foundational: false}) }}().get{{ classifier.getName() }}().isSuperTypeOf(obj.eClass());
}
{% endfor %}
{% endfile %}
