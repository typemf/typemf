{% file "util/" + switchClassName(package) + ".ts" %}
import { EObject } from '{{ coreImportSpecifier("util", "types", options) }}';
import { Ids } from '../{{ packageClassName(package) }}.js';
import { {% for classifier in eClassesOf(package) %}{{ classifier.getName() }}{% if not loop.last %}, {% endif %}{% endfor %} } from '../types/index.js';

export abstract class {{ switchClassName(package) }}<T> {
  doSwitch(eObject: EObject): T | undefined {
    switch (eObject.eClass().getClassifierID()) {
{% for classifier in concreteEClassesOf(package) %}
      case Ids.{{ classifier.getName() }}.self: {
        // {{ classifier.getName() }}
        let result: T | undefined;
{% for c in superTypeChain(classifier) %}
        result = this.case{{ c.getName() }}(eObject as {{ c.getName() }});
        if (result !== undefined) return result;
{% endfor %}
        return this.defaultCase(eObject);
      }
{% endfor %}
      default:
        return this.defaultCase(eObject);
    }
  }

{% for classifier in eClassesOf(package) %}
  case{{ classifier.getName() }}(object: {{ classifier.getName() }}): T | undefined {
    void object;
    return undefined;
  }
{% endfor %}

  defaultCase(object: EObject): T | undefined {
    void object;
    return undefined;
  }
}
{% endfile %}
