{% file "util/" + switchClassName(package) + ".ts" %}
export abstract class {{ switchClassName(package) }}<T> {
  doSwitch(eObject: {{ useImport("EObject", "types", {foundational: true}) }}): T | undefined {
    switch (eObject.eClass().getClassifierID()) {
{% for classifier in concreteEClassesOf(package) %}
      case {{ useImport("Ids", "root", {file: packageClassName(package), foundational: false}) }}.{{ classifier.getName() }}.self: {
        // {{ classifier.getName() }}
{% for c in superTypeChain(classifier) %}
        const result{{ loop.index }} = this.case{{ c.getName() }}(eObject as {{ useImport(c.getName(), "types", {foundational: false}) }});
        if (result{{ loop.index }} !== undefined) return result{{ loop.index }};
{% endfor %}
        return this.defaultCase(eObject);
      }
{% endfor %}
      default:
        return this.defaultCase(eObject);
    }
  }

{#- `_object` (not `object`): every stub below always returns `undefined` without looking at
    its argument - it exists purely as an override point for subclasses, which are free to
    name their own parameter however they like (TypeScript overriding is structural, not
    name-based). A leading underscore says so directly and avoids the `void object;` marker
    statement a merely-unused `object` parameter would otherwise need. #}
{% for classifier in eClassesOf(package) %}
  case{{ classifier.getName() }}(_object: {{ useImport(classifier.getName(), "types", {foundational: false}) }}): T | undefined {
    return undefined;
  }
{% endfor %}

  defaultCase(_object: {{ useImport("EObject", "types", {foundational: true}) }}): T | undefined {
    return undefined;
  }
}
{% endfile %}
