{% file "index.ts" %}
export * from './{{ packageClassName(package) }}.js';
export * from './{{ factoryClassName(package) }}.js';
{% endfile %}
{% file "types/index.ts" %}
{% for classifier in eClassesOf(package) %}
export * from './{{ classifier.getName() }}.js';
{% endfor %}
{% for classifier in package.getEClassifiers() %}
{% if isEEnum(classifier) %}
export * from './{{ classifier.getName() }}.js';
{% endif %}
{% endfor %}
{% endfile %}
{% file "impl/index.ts" %}
export * from './{{ packageClassName(package) }}Impl.js';
export * from './{{ factoryClassName(package) }}Impl.js';
{% for classifier in eClassesOf(package) %}
export * from './{{ classifier.getName() }}Impl.js';
{% endfor %}
{% endfile %}
