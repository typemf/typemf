{% set superClass = superType(eClass) %}
{% set ownFeatures = eClass.getEStructuralFeatures() %}
{% file "types/" + eClass.getName() + ".ts" %}
{{ coreImportLine(["EObject", "EList"], "types", "types", options, package) }}
{% if superClass %}
import { {{ superClass.getName() }} } from './{{ superClass.getName() }}.js';
{% endif %}
{% for typeName in referencedApiTypes(ownFeatures, eClass.getName(), superClass.getName() if superClass else '') %}
import { {{ typeName }} } from './{{ typeName }}.js';
{% endfor %}

{{ docComment(eClass) }}
export interface {{ eClass.getName() }} extends {{ superClass.getName() if superClass else "EObject" }} {
{% for feature in ownFeatures %}
{{ docComment(feature, "  ") }}
{% if feature.isMany() %}
  get{{ ucfirst(feature.getName()) }}(): EList<{{ tsScalarType(feature.getEType()) }}>;
{% else %}
  {{ beanGetterName(feature) }}(): {{ tsOptionalScalarType(feature.getEType()) }};
{% if not trivialDerivedFormula(feature) %}
  set{{ ucfirst(feature.getName()) }}(value: {{ tsOptionalScalarType(feature.getEType()) }}): void;
{% endif %}
{% endif %}
{% endfor %}
{% for op in eClass.getEOperations() %}
{{ docComment(op, "  ") }}
  {{ op.getName() }}({{ paramList(op) }}): {{ tsOperationReturnType(op) }};
{% endfor %}
}
{% endfile %}
{% file "impl/" + eClass.getName() + "Impl.ts" %}
{{ coreImportLine(["EClass", "EList", "EObject", "EStructuralFeature"], "impl", "types", options, package) }}
{{ coreImportLine(["EObjectImpl", "BasicEList"], "impl", "impl", options, package) }}
import { {{ eClass.getName() }} } from '../types/{{ eClass.getName() }}.js';
import { get{{ packageClassName(package) }}Ref } from './{{ packageClassName(package) }}Ref.js';
{% for typeName in referencedApiTypes(ownFeatures, eClass.getName()) %}
import { {{ typeName }} } from '../types/{{ typeName }}.js';
{% endfor %}
{% if superClass %}
import { {{ superClass.getName() }}Impl } from './{{ superClass.getName() }}Impl.js';
{% endif %}

{{ docComment(eClass) }}
export class {{ eClass.getName() }}Impl extends {{ (superClass.getName() + "Impl") if superClass else "EObjectImpl" }} implements {{ eClass.getName() }} {
{% for feature in ownFeatures %}
{% if feature.isMany() %}
  {#- Lazy: the eager form ("private readonly _{name} = new BasicEList(this,
      {Pkg}Impl.eINSTANCE.get{Class}_{Feature}())") looks up its own feature
      the moment ANY instance of this class is constructed - including
      instances built as part of {Pkg}PackageImpl's OWN construction (every
      generated class's ancestor chain runs through EModelElementImpl,
      whose own such field is built this way). For ordinary generated
      packages this is harmless (the package singleton already exists by
      the time anything else is constructed) - but for a self-hosted
      package describing its own metamodel, the singleton doesn't exist
      yet while it's still constructing itself, and eagerly resolving a
      feature during that construction is a genuine bootstrap deadlock,
      not merely wasted work. Deferring the lookup to first real access
      (add/remove, iteration, non-empty check) means it's simply never
      triggered during construction, self-hosted or not - fixing the
      deadlock as a side effect of being correct about when the feature
      is actually needed, rather than special-casing self-hosting. #}
  private _{{ feature.getName() }}Cache: BasicEList<{{ tsScalarType(feature.getEType()) }}> | undefined;

  private get _{{ feature.getName() }}(): BasicEList<{{ tsScalarType(feature.getEType()) }}> {
    if (!this._{{ feature.getName() }}Cache) {
      this._{{ feature.getName() }}Cache = new BasicEList<{{ tsScalarType(feature.getEType()) }}>(this, get{{ packageClassName(package) }}Ref().get{{ eClass.getName() }}_{{ ucfirst(feature.getName()) }}());
    }
    return this._{{ feature.getName() }}Cache;
  }
{% else %}
  private _{{ feature.getName() }}: {{ tsOptionalScalarType(feature.getEType()) }}{% if isPrimitiveValueType(feature.getEType()) %} = {{ primitiveDefaultValue(feature.getEType()) }}{% endif %};
{% endif %}
{% endfor %}

{% if eClass.getName() == "EClassifier" %}
  {#- classifierID is real, internal dispatch bookkeeping (matching
      @typemf/core's own hand-written EClassifierImpl), not a modeled
      Ecore feature - so it's declared here, once, on EClassifier itself
      (inherited by every descendant: EClass, EDataType, EEnum, ...)
      rather than emitted by the ordinary feature-driven generation
      above, which has no feature to generate it from. Confirmed
      necessary by actually running self-hosted bootstrap code (which
      constructs real EClassifier-derived metaclass shells and needs to
      set their classifierID), not assumed - see NOTES.md. #}
  private classifierId = -1;

  getClassifierID(): number {
    return this.classifierId;
  }

  setClassifierID(id: number): void {
    this.classifierId = id;
  }
{% endif %}
{% if eClass.getName() == "EStructuralFeature" %}
  {#- featureID: the exact same real gap as classifierID above, one level
      down the hierarchy - internal dispatch bookkeeping (matching
      @typemf/core's own hand-written EStructuralFeatureImpl), not a
      modeled Ecore feature, declared once here on EStructuralFeature
      itself (inherited by EAttribute, EReference, ...). Found the same
      way: running self-hosted bootstrap code, which constructs real
      EStructuralFeature-derived metaclass shells (EAttributeImpl,
      EReferenceImpl) and needs to set their featureID - see NOTES.md. #}
  private featureId = -1;

  getFeatureID(): number {
    return this.featureId;
  }

  setFeatureID(id: number): void {
    this.featureId = id;
  }
{% endif %}

  eClass(): EClass {
    return get{{ packageClassName(package) }}Ref().get{{ eClass.getName() }}();
  }

{% for feature in ownFeatures %}
{% if feature.isMany() %}
  get{{ ucfirst(feature.getName()) }}(): EList<{{ tsScalarType(feature.getEType()) }}> {
    return this._{{ feature.getName() }};
  }
{% else %}
{% set formula = trivialDerivedFormula(feature) %}
{% if formula %}
  {{ beanGetterName(feature) }}(): {{ tsOptionalScalarType(feature.getEType()) }} {
    return {{ formula }};
  }
{% else %}
  {{ beanGetterName(feature) }}(): {{ tsOptionalScalarType(feature.getEType()) }} {
    return this._{{ feature.getName() }};
  }

  set{{ ucfirst(feature.getName()) }}(value: {{ tsOptionalScalarType(feature.getEType()) }}): void {
    this.eSet(get{{ packageClassName(package) }}Ref().get{{ eClass.getName() }}_{{ ucfirst(feature.getName()) }}(), value);
  }
{% endif %}
{% endif %}
{% endfor %}
{% for group in groupOperationsByName(eClass.getEOperations()) %}
{% set op = group[0] %}
{% if group.length == 1 and isBookkeepingOperation(op, eClass) %}
{#- Skip entirely: real Ecore.ecore declares this operation for real
    (getClassifierID/getFeatureID), but it collides by name with the
    hand-added bookkeeping method above (needed for the self-hosting
    bootstrap fix - see isBookkeepingOperation's own doc comment), which
    already provides a correct, real implementation. Generating a second,
    throwing-stub method of the same name here would just be the last
    declaration silently winning at runtime, shadowing the real one. #}
{% elif group.length > 1 %}
{#- Overloaded (2+ EOperations sharing this name - real Ecore.ecore has
    this, e.g. EEnum.getEEnumLiteral by name vs by value). Scoped to
    same-arity overloads only (see NOTES.md): every overload signature is
    emitted with no body (a TS class can only have one), followed by ONE
    implementation signature whose parameter list is the union of every
    overload's types at each position (see mergedParamList). Always
    throws regardless of any individual overload's own body:typescript
    annotation - dispatching to a specific overload's real body based on
    the merged, runtime-typeof'd arguments is a bigger feature this scope
    does not attempt; every overload real Ecore.ecore actually has is
    bodyless anyway. #}
{% for o in group %}
  {{ o.getName() }}({{ paramList(o) }}): {{ tsOperationReturnType(o) }};
{% endfor %}
  {{ op.getName() }}({{ mergedParamList(group) }}): {{ mergedReturnType(group) }} {
    throw new Error('{{ eClass.getName() }}.{{ op.getName() }}() is overloaded with no body:typescript annotation - nothing to generate.');
  }
{% else %}
{% set body = operationBody(op) %}
{% if body %}
  {{ op.getName() }}({{ paramList(op) }}): {{ tsOperationReturnType(op) }} {
    {{ body }}
  }
{% else %}
  {#- No body:typescript annotation - there is no further hand-editable
      layer to fill this in anymore (Gen/Impl merged: this class is
      instantiated directly via `new X Impl()` in the Factory, so it
      cannot have any abstract members). A clear throwing stub is the
      honest behavior for fully-generated code with nothing to base a
      real implementation on, rather than silently failing to compile or
      silently doing nothing. #}
  {{ op.getName() }}({{ paramList(op) }}): {{ tsOperationReturnType(op) }} {
    throw new Error('{{ eClass.getName() }}.{{ op.getName() }}() has no body:typescript annotation - nothing to generate.');
  }
{% endif %}
{% endif %}
{% endfor %}

  eGet(feature: EStructuralFeature): unknown {
    switch (feature.getFeatureID()) {
{% for feature in ownFeatures %}
      case {{ feature.getFeatureID() }}: return this._{{ feature.getName() }};
{% endfor %}
      default:
{% if superClass %}
        return super.eGet(feature);
{% else %}
        throw new Error(`{{ eClass.getName() }} has no feature with id ${feature.getFeatureID()}`);
{% endif %}
    }
  }

  eSet(feature: EStructuralFeature, value: unknown): void {
    switch (feature.getFeatureID()) {
{% for feature in ownFeatures %}
{% if feature.isMany() %}
      case {{ feature.getFeatureID() }}: {
        const list = this._{{ feature.getName() }};
        const items = value === undefined || value === null ? [] : [...(value as Iterable<unknown>)];
        list.clear();
        for (const item of items) list.add(item as {{ tsScalarType(feature.getEType()) }});
        return;
      }
{% else %}
      case {{ feature.getFeatureID() }}: {
        const oldValue = this.eGet(feature);
        if (oldValue === value) return;
        this.eBasicSetValue(feature, value);
        this.eDidRemove(feature, oldValue);
        this.eDidAdd(feature, value);
        return;
      }
{% endif %}
{% endfor %}
      default:
{% if superClass %}
        super.eSet(feature, value);
        return;
{% else %}
        throw new Error(`{{ eClass.getName() }} has no feature with id ${feature.getFeatureID()}`);
{% endif %}
    }
  }

  {#- Accepts a plain feature-ID number as well as a real EStructuralFeature
      - needed so bootstrap code (setting a classifier shell's own name
      during self-hosted Ecore.ecore's Pass 1, before the "name" feature's
      own metaclass object exists in Pass 2 - a real, confirmed chicken-
      and-egg problem, not a hypothetical one) can bypass the metaclass
      lookup entirely and dispatch on the feature ID directly, which the
      generator already knows at codegen time (it's the literal case
      label below) and never actually needed the feature OBJECT for in
      the first place - only its ID. Ordinary callers (eSet, generated
      bean setters) are unaffected; they still pass a real feature and
      get identical behavior. #}
  eBasicSetValue(feature: EStructuralFeature | number, value: unknown): void {
    const featureId = typeof feature === 'number' ? feature : feature.getFeatureID();
    switch (featureId) {
{% for feature in singleValuedFeatures(ownFeatures) %}
      case {{ feature.getFeatureID() }}: this._{{ feature.getName() }} = value as {{ tsOptionalScalarType(feature.getEType()) }}; return;
{% endfor %}
      default:
{% if superClass %}
        super.eBasicSetValue(feature, value);
        return;
{% else %}
        throw new Error(`Feature ${featureId} on {{ eClass.getName() }} is many-valued or unknown.`);
{% endif %}
    }
  }

  {#- The many-valued analog of eBasicSetValue, for the identical reason:
      bootstrap code needs to add to a list (eStructuralFeatures,
      eAnnotations, eSuperTypes, ...) before the feature's own metaclass
      exists to back the ordinary getter's lazy construction. Constructs
      the cache with no feature reference when called this way - a real,
      narrow, deliberate limitation: containment/opposite maintenance on
      a list built this way is unavailable, since there's no feature to
      derive it from. Acceptable specifically because only the metamodel's
      own self-describing bootstrap instances (EClassImpl, EAttributeImpl,
      etc., as constructed by {Pkg}PackageImpl) ever take this path -
      ordinary domain instances always go through the normal, fully-
      wired getter instead, never this one. #}
  eBootstrapList(featureId: number): BasicEList<unknown> {
    switch (featureId) {
{% for feature in ownFeatures %}
{% if feature.isMany() %}
      case {{ feature.getFeatureID() }}:
        if (!this._{{ feature.getName() }}Cache) this._{{ feature.getName() }}Cache = new BasicEList<{{ tsScalarType(feature.getEType()) }}>(this);
        return this._{{ feature.getName() }}Cache;
{% endif %}
{% endfor %}
      default:
{% if superClass %}
        return super.eBootstrapList(featureId);
{% else %}
        throw new Error(`Feature ${featureId} on {{ eClass.getName() }} is single-valued or unknown.`);
{% endif %}
    }
  }

  eIsSet(feature: EStructuralFeature): boolean {
    switch (feature.getFeatureID()) {
{% for feature in ownFeatures %}
{% if feature.isMany() %}
      case {{ feature.getFeatureID() }}: return this._{{ feature.getName() }}Cache !== undefined && this._{{ feature.getName() }}Cache.size() !== 0;
{% else %}
{% if isPrimitiveValueType(feature.getEType()) %}
      case {{ feature.getFeatureID() }}: return this._{{ feature.getName() }} !== {{ primitiveDefaultValue(feature.getEType()) }};
{% else %}
      case {{ feature.getFeatureID() }}: return this._{{ feature.getName() }} !== undefined;
{% endif %}
{% endif %}
{% endfor %}
      default:
{% if superClass %}
        return super.eIsSet(feature);
{% else %}
        throw new Error(`{{ eClass.getName() }} has no feature with id ${feature.getFeatureID()}`);
{% endif %}
    }
  }

  eUnset(feature: EStructuralFeature): void {
    switch (feature.getFeatureID()) {
{% for feature in ownFeatures %}
{% if feature.isMany() %}
      case {{ feature.getFeatureID() }}: this._{{ feature.getName() }}Cache?.clear(); return;
{% else %}
      case {{ feature.getFeatureID() }}: {
        const oldValue = this._{{ feature.getName() }};
{% if isPrimitiveValueType(feature.getEType()) %}
        this._{{ feature.getName() }} = {{ primitiveDefaultValue(feature.getEType()) }};
{% else %}
        this._{{ feature.getName() }} = undefined;
{% endif %}
        this.eDidRemove(feature, oldValue);
        return;
      }
{% endif %}
{% endfor %}
      default:
{% if superClass %}
        super.eUnset(feature);
        return;
{% else %}
        throw new Error(`{{ eClass.getName() }} has no feature with id ${feature.getFeatureID()}`);
{% endif %}
    }
  }
}
{% endfile %}
