{
  "name": "@typemf/generator",
  "version": "0.8.1",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "typemf-generate": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typemf/typemf.git",
    "directory": "packages/generator"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@typemf/core": "workspace:*",
    "@typemf/node": "workspace:*",
    "@typemf/xmi": "workspace:*",
    "nunjucks": "^3.2.4",
    "prettier": "^3.9.8"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/nunjucks": "^3.2.6"
  }
}
